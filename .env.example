# Salin file ini menjadi .env lalu isi sesuai server kamu.
# .env berisi password: jangan di-upload ke GitHub atau dibagikan.

# --- Aplikasi ---
# development atau production
APP_ENV=development
APP_URL=http://localhost/tebak-perangkat
APP_TIMEZONE=Asia/Jakarta

# --- Database MySQL (dipakai website) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_tebakperangkat
# User khusus aplikasi (lihat database/create_user.sql). Di XAMPP lokal boleh root dengan password kosong.
DB_USER=tebakperangkat
DB_PASSWORD=GANTI_PASSWORD
DB_CHARSET=utf8mb4

# --- User untuk migrasi (php artisan migrate) ---
# Butuh hak membuat/mengubah tabel, biasanya root. Kosongkan agar memakai DB_USER.
DB_MIGRATE_USER=root
DB_MIGRATE_PASSWORD=

# --- Sesi login ---
SESSION_LIFETIME_DAYS=30

# --- Aturan game ---
START_COINS=100
DAILY_COINS=50
