{
  // Pemeriksaan tipe untuk JavaScript game di browser (file .js + komentar JSDoc).
  // Jalankan: bun tsc --noEmit   (tidak menghasilkan file apa pun, hanya memeriksa)
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["public/js/**/*"]
}
