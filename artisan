<?php
/*
 * Perintah terminal ala Laravel. Jalankan dari folder proyek:
 *
 *   php artisan migrate                       jalankan semua migrasi yang belum dijalankan
 *   php artisan migrate:status                lihat migrasi mana yang sudah/belum dijalankan
 *   php artisan migrate:rollback              batalkan kelompok (batch) migrasi terakhir
 *   php artisan migrate:fresh --force         HAPUS semua tabel lalu migrasi ulang (data hilang!)
 *   php artisan make:migration nama_baru      buat file migrasi baru dari template
 *
 * Setiap file di database/migrations/ mengembalikan ['up' => ..., 'down' => ...].
 * Isinya boleh satu query SQL, array beberapa query, atau function (PDO $db) { ... }.
 */
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
require __DIR__ . '/bootstrap/app.php';

use App\Core\DB;

$cmd = $argv[1] ?? 'list';
$dir = base_path('database/migrations');

if ($cmd === 'make:migration') {
    $name = preg_replace('/[^a-z0-9_]+/', '_', strtolower($argv[2] ?? ''));
    if ($name === '') exit("Contoh: php artisan make:migration tambah_kolom_avatar\n");
    $file = $dir . '/' . date('Y_m_d_His') . "_$name.php";
    file_put_contents($file, "<?php\nreturn [\n    'up' => [\n        \"-- tulis query di sini, mis. ALTER TABLE players ADD COLUMN avatar VARCHAR(255) NULL\",\n    ],\n    'down' => [\n        \"-- query untuk membatalkan, mis. ALTER TABLE players DROP COLUMN avatar\",\n    ],\n];\n");
    exit("Dibuat: database/migrations/" . basename($file) . "\n");
}

if (!in_array($cmd, ['migrate', 'migrate:status', 'migrate:rollback', 'migrate:fresh'], true)) {
    exit("Perintah yang tersedia:\n  migrate\n  migrate:status\n  migrate:rollback\n  migrate:fresh --force\n  make:migration <nama>\n");
}

// Migrasi butuh hak membuat tabel: pakai DB_MIGRATE_USER kalau diisi, kalau tidak pakai DB_USER
$dbName = config('database.database');
if (!preg_match('/^\w+$/', $dbName)) exit("DB_NAME di .env tidak valid.\n");
$user = config('database.migrate_username') ?: config('database.username');
$pass = config('database.migrate_username') ? config('database.migrate_password') : config('database.password');

$createMigrationsTable = "CREATE TABLE IF NOT EXISTS migrations (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    migration VARCHAR(255) NOT NULL UNIQUE,
    batch INT UNSIGNED NOT NULL,
    ran_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB";

try {
    DB::connect($user, $pass, false)->exec("CREATE DATABASE IF NOT EXISTS `$dbName` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    $pdo = DB::connect($user, $pass);
    $pdo->exec($createMigrationsTable);
} catch (PDOException $e) {
    exit("Gagal terhubung ke MySQL: " . $e->getMessage() . "\nPeriksa DB_HOST, DB_MIGRATE_USER, dan DB_MIGRATE_PASSWORD di .env\n");
}

function run_step(PDO $pdo, $step): void
{
    if ($step instanceof Closure) { $step($pdo); return; }
    foreach ((array) $step as $sql) {
        if (trim($sql) !== '' && strpos(ltrim($sql), '--') !== 0) $pdo->exec($sql);
    }
}

function migration_files(string $dir): array
{
    $files = glob("$dir/*.php");
    sort($files);
    return $files;
}

function migrate_up(PDO $pdo, string $dir): void
{
    $ran = $pdo->query("SELECT migration FROM migrations")->fetchAll(PDO::FETCH_COLUMN);
    $pending = array_values(array_filter(migration_files($dir), fn($f) => !in_array(basename($f, '.php'), $ran, true)));
    if (!$pending) { echo "Tidak ada migrasi baru.\n"; return; }
    $batch = (int) $pdo->query("SELECT COALESCE(MAX(batch), 0) + 1 FROM migrations")->fetchColumn();
    foreach ($pending as $file) {
        $name = basename($file, '.php');
        $m = require $file;
        try {
            run_step($pdo, $m['up']);
        } catch (Throwable $e) {
            exit("GAGAL  $name\n       " . $e->getMessage() . "\n");
        }
        $pdo->prepare("INSERT INTO migrations (migration, batch) VALUES (?, ?)")->execute([$name, $batch]);
        echo "OK     $name\n";
    }
}

switch ($cmd) {
    case 'migrate':
        migrate_up($pdo, $dir);
        break;

    case 'migrate:status':
        $ran = $pdo->query("SELECT migration, batch FROM migrations")->fetchAll(PDO::FETCH_KEY_PAIR);
        foreach (migration_files($dir) as $f) {
            $name = basename($f, '.php');
            echo isset($ran[$name]) ? "[x] batch {$ran[$name]}  $name\n" : "[ ] belum    $name\n";
        }
        break;

    case 'migrate:rollback':
        $batch = (int) $pdo->query("SELECT COALESCE(MAX(batch), 0) FROM migrations")->fetchColumn();
        if (!$batch) { echo "Belum ada migrasi untuk dibatalkan.\n"; break; }
        $st = $pdo->prepare("SELECT migration FROM migrations WHERE batch = ? ORDER BY id DESC");
        $st->execute([$batch]);
        foreach ($st->fetchAll(PDO::FETCH_COLUMN) as $name) {
            $file = "$dir/$name.php";
            if (!is_file($file)) exit("File migrasi hilang: $name.php\n");
            $m = require $file;
            try {
                run_step($pdo, $m['down']);
            } catch (Throwable $e) {
                exit("GAGAL rollback  $name\n       " . $e->getMessage() . "\n");
            }
            $pdo->prepare("DELETE FROM migrations WHERE migration = ?")->execute([$name]);
            echo "BATAL  $name\n";
        }
        break;

    case 'migrate:fresh':
        if (!in_array('--force', $argv, true)) exit("Ini menghapus SEMUA tabel dan data di '$dbName'. Tambahkan --force jika yakin.\n");
        $pdo->exec('SET FOREIGN_KEY_CHECKS = 0');
        foreach ($pdo->query("SELECT TABLE_NAME, TABLE_TYPE FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE()")->fetchAll() as $t) {
            $pdo->exec(($t['TABLE_TYPE'] === 'VIEW' ? 'DROP VIEW' : 'DROP TABLE') . " `{$t['TABLE_NAME']}`");
        }
        $pdo->exec('SET FOREIGN_KEY_CHECKS = 1');
        echo "Semua tabel dihapus.\n";
        $pdo->exec($createMigrationsTable);
        migrate_up($pdo, $dir);
        break;
}
